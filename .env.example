# Copy to .env.local. Every value here is validated for shape at boot by
# src/lib/env.ts — a malformed one fails the deploy instead of producing an
# empty dashboard.

# --- Supabase ---------------------------------------------------------------
# The anon key is the only one the browser ever sees. The service-role key is
# read exclusively by API routes and scripts/.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection. Used only by scripts/db-*.ts to apply and verify
# the migration; the app itself never uses it.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- GoHighLevel ------------------------------------------------------------
# Marketplace app credentials. Per-client access tokens are stored in
# oauth_tokens and refreshed on read, not kept here.
# Optional at boot: the app starts without these and shows empty states. The
# syncs and the OAuth routes fail with a clear message instead.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:3000/api/oauth/crm/callback
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# An agency-level Private Integration token, used ONLY for provisioning a new
# sub-account and writing its custom values. Optional: without it those two
# calls fall back to the marketplace app OAuth token, and every read sync uses
# OAuth either way.
#
# Worth setting because its scopes are chosen in the GoHighLevel UI, so granting
# locations.write takes a minute rather than reinstalling the app across the
# agency, and because it does not expire — provisioning then skips the
# refresh-token lease that exists because GoHighLevel invalidates a refresh
# token the moment it is used.
#
# Needs: locations.write, locations/customValues.write, snapshots.readonly.
# A long-lived secret with no rotation. Environment only — never the database,
# never a log, never a browser.
GHL_PRIVATE_TOKEN=

# --- Windsor.ai -------------------------------------------------------------
# The ad data source. One key covers every connected ad account, so there is no
# per-account Meta token to expire. Optional: the app boots without it and the
# ads sync fails with a clear message.
WINDSOR_API_KEY=
WINDSOR_API_BASE=https://connectors.windsor.ai

# --- Stripe -----------------------------------------------------------------
# Restricted key (rk_...), READ scopes only. This is how /billing knows which
# client charges succeeded and which were declined — GoHighLevel holds no record
# of Apex billing its clients, so Stripe is the only source.
#
# Needs read on: payment intents, charges, invoices, invoice items, customers,
# subscriptions, products, prices, events, refunds, disputes. Nothing else, and
# no write access anywhere.
#
# A secret key (sk_...) is REJECTED at boot on purpose. It would work for reads
# while also granting the ability to charge cards and issue refunds, and nothing
# in this app needs that. Optional: without it the billing sync fails with a
# clear message and the page shows an empty state.
STRIPE_RESTRICTED_KEY=

# --- Cron -------------------------------------------------------------------
# Vercel cron sends this as a bearer token. Minimum 24 characters.
# Vercel is the ONE scheduler for this app; do not add CI-based jobs against
# the same database.
CRON_SECRET=

# --- Machine-to-machine -----------------------------------------------------
# Bearer token for /api/tokens/ghl, which hands a valid CRM token to Make.
# Separate from CRON_SECRET so it can be rotated without touching the crons.
# Minimum 32 characters.
SERVICE_API_KEY=

# --- Slack ------------------------------------------------------------------
# Incoming webhook for sync failure alerts, posted to #tech-team. Optional:
# without it the syncs still record everything to sync_runs, just silently.
# A webhook rather than a bot token because it can only post to one channel.
SLACK_WEBHOOK_URL=

# The @apex ticket bot: tagging it in Slack files a ticket on /tech-support.
# Both come from the Slack app at api.slack.com/apps. See the README.
#
# The signing secret is under Basic Information -> App Credentials, and it is
# what authenticates inbound events -- /api/slack/events has a public URL by
# necessity, because Slack decides what it sends and cannot add an
# Authorization header. Without this the route answers 503 and no ticket can
# be filed at all.
SLACK_SIGNING_SECRET=
# The Bot User OAuth Token, under OAuth & Permissions. Must start xoxb-; a user
# token (xoxp-) is rejected because it would carry the installing person's whole
# reach. Without it tickets are still filed, the bot just cannot say so in the
# thread.
SLACK_BOT_TOKEN=

# Deciding whether a message that tagged @apex is actually asking for work.
#
# Optional, and its absence is a supported state: without it every mention
# becomes a ticket, which is how the bot behaved before the classifier existed.
# lib/slack/classify fails open on every path -- no key, timeout, bad answer --
# because an outage must never turn a real support request into silence.
ANTHROPIC_API_KEY=
# Which model triages mentions. Defaults to claude-opus-5. Point it at a
# cheaper, faster model if this team's traffic makes that the better trade --
# it is a judgement about volume, not a code decision.
SLACK_CLASSIFIER_MODEL=

# Who Slack-raised tickets are assigned to. Defaults to Ally when left blank.
# Matched against user_profiles.email, case-insensitively -- a ticket whose
# assignee matches no Hub user is filed unassigned and says so in the thread.
TECH_SUPPORT_ASSIGNEE_EMAIL=

# Public origin, so an alert can link back to /settings. On Vercel this is
# inferred from VERCEL_URL and can be left blank.
NEXT_PUBLIC_APP_URL=

# Private marketplace apps pin an install to a specific app version. Copy the
# version_id from the marketplace install link. Optional: omitted when blank.
GHL_APP_VERSION_ID=6a87285031f12a3e2fa93832

# Google service account, for reading the Client Fulfilment Tracker.
# Create the account in Google Cloud, enable the Sheets API, then share the
# tracker with the service account's email as a Viewer — it can see nothing
# until you do. The key may keep its real newlines or use escaped \n; both work.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
FULFILMENT_TRACKER_SHEET_ID=
