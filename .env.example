# Copy to .env.local. Every value here is validated for shape at boot by
# src/lib/env.ts — a malformed one fails the deploy instead of producing an
# empty dashboard.

# --- Supabase ---------------------------------------------------------------
# The anon key is the only one the browser ever sees. The service-role key is
# read exclusively by API routes and scripts/.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection. Used only by scripts/db-*.ts to apply and verify
# the migration; the app itself never uses it.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- GoHighLevel ------------------------------------------------------------
# Marketplace app credentials. Per-client access tokens are stored in
# oauth_tokens and refreshed on read, not kept here.
# Optional at boot: the app starts without these and shows empty states. The
# syncs and the OAuth routes fail with a clear message instead.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:3000/api/oauth/crm/callback
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# --- Windsor.ai -------------------------------------------------------------
# The ad data source. One key covers every connected ad account, so there is no
# per-account Meta token to expire. Optional: the app boots without it and the
# ads sync fails with a clear message.
WINDSOR_API_KEY=
WINDSOR_API_BASE=https://connectors.windsor.ai

# --- Stripe -----------------------------------------------------------------
# Restricted key (rk_...), READ scopes only. This is how /billing knows which
# client charges succeeded and which were declined — GoHighLevel holds no record
# of Apex billing its clients, so Stripe is the only source.
#
# Needs read on: payment intents, charges, invoices, invoice items, customers,
# subscriptions, products, prices, events, refunds, disputes. Nothing else, and
# no write access anywhere.
#
# A secret key (sk_...) is REJECTED at boot on purpose. It would work for reads
# while also granting the ability to charge cards and issue refunds, and nothing
# in this app needs that. Optional: without it the billing sync fails with a
# clear message and the page shows an empty state.
STRIPE_RESTRICTED_KEY=

# --- Cron -------------------------------------------------------------------
# Vercel cron sends this as a bearer token. Minimum 24 characters.
# Vercel is the ONE scheduler for this app; do not add CI-based jobs against
# the same database.
CRON_SECRET=

# --- Machine-to-machine -----------------------------------------------------
# Bearer token for /api/tokens/ghl, which hands a valid CRM token to Make.
# Separate from CRON_SECRET so it can be rotated without touching the crons.
# Minimum 32 characters.
SERVICE_API_KEY=

# --- Slack ------------------------------------------------------------------
# Incoming webhook for sync failure alerts, posted to #tech-team. Optional:
# without it the syncs still record everything to sync_runs, just silently.
# A webhook rather than a bot token because it can only post to one channel.
SLACK_WEBHOOK_URL=

# Public origin, so an alert can link back to /settings. On Vercel this is
# inferred from VERCEL_URL and can be left blank.
NEXT_PUBLIC_APP_URL=

# Private marketplace apps pin an install to a specific app version. Copy the
# version_id from the marketplace install link. Optional: omitted when blank.
GHL_APP_VERSION_ID=6a87285031f12a3e2fa93832
