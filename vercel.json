{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sync-all",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/sync/crm-appointments",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/sync/raw-call-rows",
      "schedule": "0 13,16,19,22 * * *"
    },
    {
      "path": "/api/cron/slack-autoreply",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "src/app/api/sync/**/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/**/route.ts": {
      "maxDuration": 300
    }
  }
}
